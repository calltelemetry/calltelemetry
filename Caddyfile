# Caddyfile

{
    # Bind admin API to all interfaces (metrics at :2019/metrics)
    admin 0.0.0.0:2019
    # Enable HTTP request metrics (caddy_http_requests_total, latency histograms, etc.)
    metrics
}

# HTTP: proxy CURRI/XCC/phone-portal paths to Phoenix, redirect everything else to HTTPS
:80 {
    @backend path /api/* /healthz /org/* /socket/* /live/*
    handle @backend {
        reverse_proxy web:4080
    }
    handle {
        redir https://{host}{uri} permanent
    }
}

:443 {
    # Expose Caddy metrics (served on admin API :2019/metrics)
    metrics

    # CUBE XCC callback. `post /xcc/:cube_id` is defined ONLY on the CURRI
    # endpoint (web:4080) — the admin endpoint below (web:4000) has no such
    # route, and its pipeline does not accept SOAP XML bodies. Without this
    # rule an HTTPS Application URL 404s, and it 404s AFTER registration
    # already looks successful, so it presents as a keepalive fault rather
    # than a routing fault.
    #
    # Keep this ABOVE the /api* rule. Caddy matches the most specific path
    # first, so order is not strictly required, but the two rules must stay
    # adjacent so the split is obvious to the next reader.
    reverse_proxy /api/xcc* web:4080

    reverse_proxy /api* web:4000

    # CT app metrics — unauthenticated, for PRTG/external Prometheus scraping
    handle /metrics {
        reverse_proxy web:4080
    }

    reverse_proxy /* vue-web:8080

    # Cache headers - order matters! More specific rules FIRST
    header /assets/* {
        Cache-Control "public, max-age=31536000, immutable"
        # Remove ETags for immutable assets - they're versioned in the filename
        -ETag
    }

    header /* {
        Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        # Remove ETags to prevent 304 responses with stale content
        -ETag
        # Add Pragma for HTTP/1.0 compatibility
        Pragma "no-cache"
    }

    tls /certs/appliance.crt /certs/appliance_key.pem  # Default certificate and key files
}